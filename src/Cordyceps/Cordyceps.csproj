<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 7 (macOS Mono + Windows .NET Framework 4.8) -->
    <TargetFramework>net48</TargetFramework>
    <!-- C# 9 for switch expressions, `or`/type patterns, and target-typed conditionals.
         All are compiler-only features that emit fine against net48. Records and init-only
         setters WOULD need an IsExternalInit shim; the codebase uses neither. -->
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>

    <!-- Only allow Release builds -->
    <Configurations>Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cordyceps.Tests" />
  </ItemGroup>



  <!-- Block Debug builds with a clear error message -->
  <Target Name="BlockDebugBuilds" BeforeTargets="Build" Condition=" '$(Configuration)' != 'Release' ">
    <Error Text="Only Release builds are supported. Use 'dotnet build -c Release'." />
  </Target>

  <PropertyGroup>
    <!-- Release optimization settings -->
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Specifies information for Assembly -->
    <Version>1.4.12</Version>
    <Title>Cordyceps</Title>
    <Company>Brooks Talley</Company>
    <Description>Grasshopper MCP Bridge - Claude takes control of Grasshopper</Description>
    <!-- Embed build timestamp into assembly -->
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Grasshopper (Rhino 7) -->
    <PackageReference Include="Grasshopper" Version="7.13.21348.13001" ExcludeAssets="runtime" />

    <!-- JSON serialization -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Reference WinForms for cross-platform .NET 7.0 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" GeneratePathProperty="true" />
    <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/System.Windows.Forms.dll" Private="False" />
    <!-- `dynamic` call sites bind through Microsoft.CSharp.RuntimeBinder at runtime. -->
    <Reference Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net48)/build/.NETFramework/v4.8/Microsoft.CSharp.dll" Private="False" />
    
  </ItemGroup>

  <!-- Component icon -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\CordycepsIcon.png" />
  </ItemGroup>

  <!-- Embedded documentation resources -->
  <ItemGroup>
    <EmbeddedResource Include="Knowledge\GettingStartedGuide.md" />
    <EmbeddedResource Include="Knowledge\DataTreesGuide.md" />
    <EmbeddedResource Include="Knowledge\TypeSystemGuide.md" />
    <EmbeddedResource Include="Knowledge\BestPracticesGuide.md" />
    <EmbeddedResource Include="Knowledge\ComponentPatternsGuide.md" />
    <EmbeddedResource Include="Knowledge\CanvasLayoutGuide.md" />
    <EmbeddedResource Include="Knowledge\GeometryOrientationGuide.md" />
    <EmbeddedResource Include="Knowledge\McpTestingGuide.md" />
    <EmbeddedResource Include="Knowledge\RenderingGuide.md" />
    <EmbeddedResource Include="Knowledge\CommonErrorsGuide.md" />
    <EmbeddedResource Include="Knowledge\Patterns\LinearArray.md" />
    <EmbeddedResource Include="Knowledge\Patterns\GridArray.md" />
    <EmbeddedResource Include="Knowledge\Prompts\CreateParametricGeometry.md" />
    <EmbeddedResource Include="Knowledge\Prompts\DebugDataMismatch.md" />
    <EmbeddedResource Include="Knowledge\Prompts\SetupScriptComponent.md" />
    <EmbeddedResource Include="Knowledge\Prompts\OptimizeCanvas.md" />
    <EmbeddedResource Include="Knowledge\Prompts\PlanDefinition.md" />
  </ItemGroup>

  <!-- Post-build: Copy .gha to releases folder for Grasshopper to load -->
  <Target Name="CopyToReleases" AfterTargets="Build">
    <PropertyGroup>
      <ReleasesFolder>$(MSBuildProjectDirectory)/../../releases</ReleasesFolder>
    </PropertyGroup>
    <MakeDir Directories="$(ReleasesFolder)" Condition="!Exists('$(ReleasesFolder)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleasesFolder)" />
    <Message Importance="High" Text="Copied $(TargetFileName) to $(ReleasesFolder)" />
  </Target>

</Project>
